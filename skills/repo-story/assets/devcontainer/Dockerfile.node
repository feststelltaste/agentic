FROM node:22
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
# The base image's user "node" (uid 1000) becomes "vscode", as devcontainer.json expects.
RUN usermod -l vscode -d /home/vscode -m node && groupmod -n vscode node && mkdir -p /cache && chown vscode /cache
USER vscode
# Always run npm ci with --ignore-scripts (see replay.sh), never silently re-resolve the lockfile.
